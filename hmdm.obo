[Term]
id: HMDM:0000933
name: Pseudomonas aeruginosa CYP107S1
namespace: human_microbiome_drug_metabolism_ontology
def: "CYP107S1 is a cytochrome P450 (CYP) enzyme found in the bacterium Pseudomonas aeruginosa. It can metabolize fluoroquinolone antibiotics (ciprofloxacin and fleroxacin), a cystic fibrosis transmembrane conductance regulator potentiator (ivacaftor), and a selective estrogen receptor modulator antimicrobial adjuvant (raloxifene)." [PMID:39032655]
is_a: HMDM:0000929 ! bacterial cytochrome P450 (CYP) family 107 subfamily
relationship: HMDM:0000938 CHEBI:66901 ! metabolizes drug ivacaftor
relationship: HMDM:0000938 HMDM:0000108 ! metabolizes drug raloxifene
property_value: dcterms:contributor https://orcid.org/0000-0001-9259-5280

[Term]
id: HMDM:0000934
name: cystic fibrosis transmembrane conductance regulator (CFTR) potentiators
namespace: human_microbiome_drug_metabolism_ontology
def: "The CFTR potentiators increase channel activity of the CFRT protein located at the cell surface and enhance ion transport. Ivacaftor is the first intervention that corrects the underlying molecular defect in CF. It has demonstrated effectiveness in people with a class III mutation (G551D) and some effectiveness with class IV mutations (R117H) and has the potential to be used for other class III and IV mutations." [PMID:25811419, PMID:30616300]
is_a: HMDM:0000073 ! drug class
property_value: dcterms:contributor https://orcid.org/0000-0001-9259-5280

