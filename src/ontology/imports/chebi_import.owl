AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_3732> "clarithromycin")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_3732> <http://purl.obolibrary.org/obo/CHEBI_25105>)
