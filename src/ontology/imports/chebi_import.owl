AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_35640> "adrenergic uptake inhibitor")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_35640> <http://purl.obolibrary.org/obo/CHEBI_37962>)

