AnnotationAssertion(dcterms:contributor obo:HMDM_0000018 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000018 "human_microbiome_drug_metabolism_ontology")
