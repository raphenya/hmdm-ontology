# Class: obo:HMDM_0000022 (dopamine precursor)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000022 "A chemical compound that participates in a chemical reaction that produces dopamine.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000022 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000022 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000022 "HMDM:0000022")
