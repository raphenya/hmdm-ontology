# Class: obo:HMDM_0000902 (apg)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:37157031") obo:IAO_0000115 obo:HMDM_0000902 "The apg is an acarbose-preferred glucosidase that was discovered in intestinal bacteria from patients with Type 2 diabetes mellitus (T2DM) chronic metabolic disease. The Apg hydrolyses acarbose into small molecules (acarviosine-glucose and acarviosine) with loss of inhibitor function to porcine pancreatic amylase and is widely distributed in human intestinal microorganisms, especially in Klebsiella.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000902 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000902 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000902 "HMDM:0000902")
AnnotationAssertion(rdfs:label obo:HMDM_0000902 "apg")
SubClassOf(obo:HMDM_0000902 obo:HMDM_0000830)
SubClassOf(obo:HMDM_0000902 ObjectSomeValuesFrom(obo:MOP_0000619 obo:CHEBI_2376))
SubClassOf(obo:HMDM_0000902 ObjectSomeValuesFrom(obo:RO_0000056 obo:HMDM_0000491))

