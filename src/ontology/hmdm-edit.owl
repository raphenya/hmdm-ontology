# Class: obo:HMDM_0000001 (root of drug metabolism)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000001 "The human gut microbiome transforms and degrade drugs using enzymes.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000001 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000001 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000001 "HMDM:0000001")
AnnotationAssertion(rdfs:label obo:HMDM_0000001 "root of drug metabolism")

# Class: obo:HMDM_0000002 (drug)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000002 "A drug is any substance that causes a change in an organism's physiology or psychology when consumed or introduced.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000002 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000002 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000002 "HMDM:0000002")
AnnotationAssertion(rdfs:label obo:HMDM_0000002 "drug")
SubClassOf(obo:HMDM_0000002 obo:HMDM_0000001)

# Class: obo:HMDM_0000006 (determinant of drug metabolism)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000006 "The primary factors that determine the drug metabolism.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000006 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000006 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000006 "HMDM:0000006")
AnnotationAssertion(rdfs:label obo:HMDM_0000006 "determinant of drug metabolism")
SubClassOf(obo:HMDM_0000006 obo:HMDM_0000001)

# Class: obo:HMDM_0000007 (mechanism of drug metabolism)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000007 "The main mechanisms of drug modification, inactivation of a drug, and drug degradation.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000007 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000007 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000007 "HMDM:0000007")
AnnotationAssertion(rdfs:label obo:HMDM_0000007 "mechanism of drug metabolism")
SubClassOf(obo:HMDM_0000007 obo:HMDM_0000001)

# Class: obo:HMDM_0000008 (classification)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000008 "The categories to group enzymes into gene families, mechanisms, and drug classes.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000008 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000008 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000008 "HMDM:0000008")
AnnotationAssertion(rdfs:label obo:HMDM_0000008 "classification")
SubClassOf(obo:HMDM_0000008 obo:HMDM_0000001)

# Class: obo:HMDM_0000010 (Escherichia coli thymidine phosphorylase (deoA))

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:32526207") Annotation(oboInOwl:hasDbXref "PMID:34260950") obo:IAO_0000115 obo:HMDM_0000010 "The enzymes which catalyze the reversible phosphorolysis of pyrimidine nucleosides are involved in the degradation of these compounds and in their utilization as carbon and energy sources, or in the rescue of pyrimidine bases for nucleotide synthesis.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000010 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000010 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000010 "HMDM:0000010")
AnnotationAssertion(rdfs:label obo:HMDM_0000010 "Escherichia coli thymidine phosphorylase (deoA)")
