# Object Property: obo:HMDM_0000938 (metabolizes drug)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000938 "A relation between an enzyme (gene product) and a drug or chemical that the enzyme metabolizes. Inverse of NCIt Chemical_Or_Drug_Is_Metabolized_By_Enzyme (NCIT:R122).")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000938 "HMDM:0000938")
AnnotationAssertion(rdfs:label obo:HMDM_0000938 "metabolizes drug")
InverseObjectProperties(obo:HMDM_0000938 obo:NCIT_R122)



############################
#   Classes
############################

# Class: obo:HMDM_0000001 (root of drug metabolism)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000001 "The human gut microbiome transforms and degrade drugs using enzymes.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000001 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000001 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000001 "HMDM:0000001")
AnnotationAssertion(rdfs:label obo:HMDM_0000001 "root of drug metabolism")

# Class: obo:HMDM_0000002 (drug)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000002 "A drug is any substance that causes a change in an organism's physiology or psychology when consumed or introduced.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000002 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000002 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000002 "HMDM:0000002")
AnnotationAssertion(rdfs:label obo:HMDM_0000002 "drug")
SubClassOf(obo:HMDM_0000002 obo:HMDM_0000001)

# Class: obo:HMDM_0000005 (antiviral)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:33726557") obo:IAO_0000115 obo:HMDM_0000005 "An agent that kills a virus or that suppresses its ability to replicate and, hence, inhibits its capability to multiply and reproduce. For example, amantadine (Symmetrel) is a synthetic antiviral. It acts by inhibiting the multiplication of the influenza A virus.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000005 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000005 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000005 "HMDM:0000005")
AnnotationAssertion(rdfs:label obo:HMDM_0000005 "antiviral")
SubClassOf(obo:HMDM_0000005 obo:HMDM_0000073)

# Class: obo:HMDM_0000006 (determinant of drug metabolism)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000006 "The primary factors that determine the drug metabolism.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000006 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000006 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000006 "HMDM:0000006")
AnnotationAssertion(rdfs:label obo:HMDM_0000006 "determinant of drug metabolism")
SubClassOf(obo:HMDM_0000006 obo:HMDM_0000001)

# Class: obo:HMDM_0000007 (mechanism of drug metabolism)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000007 "The main mechanisms of drug modification, inactivation of a drug, and drug degradation.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000007 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000007 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000007 "HMDM:0000007")
AnnotationAssertion(rdfs:label obo:HMDM_0000007 "mechanism of drug metabolism")
SubClassOf(obo:HMDM_0000007 obo:HMDM_0000001)

# Class: obo:HMDM_0000008 (classification)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000008 "The categories to group enzymes into gene families, mechanisms, and drug classes.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000008 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000008 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000008 "HMDM:0000008")
AnnotationAssertion(rdfs:label obo:HMDM_0000008 "classification")
SubClassOf(obo:HMDM_0000008 obo:HMDM_0000001)

# Class: obo:HMDM_0000009 (nucleoside antiviral)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:33924302") obo:IAO_0000115 obo:HMDM_0000009 "Among the molecules directly targeting viruses, nucleoside analogues form an essential class of broad-spectrum antiviral drugs. Many direct-acting antiviral nucleoside analogues target the viral polymerase responsible for the viral genome replication. Unlike non-nucleoside polymerase inhibitors that often bind to allosteric non-conserved and mutation-tolerant sites, nucleoside analogues directly bind to the more conserved active site of the viral polymerase after conversion to their triphosphate active form. Nucleoside analogs represent the largest class of small molecule-based antivirals, which currently form the backbone of chemotherapy of chronic infections caused by HIV, hepatitis B or C viruses, and herpes viruses.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000009 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000009 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000009 "HMDM:0000009")
AnnotationAssertion(rdfs:label obo:HMDM_0000009 "nucleoside antiviral")
SubClassOf(obo:HMDM_0000009 obo:HMDM_0000005)

# Class: obo:HMDM_0000010 (Escherichia coli thymidine phosphorylase (deoA))

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:32526207") Annotation(oboInOwl:hasDbXref "PMID:34260950") obo:IAO_0000115 obo:HMDM_0000010 "The enzymes which catalyze the reversible phosphorolysis of pyrimidine nucleosides are involved in the degradation of these compounds and in their utilization as carbon and energy sources, or in the rescue of pyrimidine bases for nucleotide synthesis.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000010 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000010 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000010 "HMDM:0000010")
AnnotationAssertion(rdfs:label obo:HMDM_0000010 "Escherichia coli thymidine phosphorylase (deoA)")
SubClassOf(obo:HMDM_0000010 obo:HMDM_0000089)
SubClassOf(obo:HMDM_0000010 ObjectSomeValuesFrom(obo:MOP_0001162 obo:CHEBI_31521))
SubClassOf(obo:HMDM_0000010 ObjectSomeValuesFrom(obo:MOP_0001162 obo:CHEBI_75179))
SubClassOf(obo:HMDM_0000010 ObjectSomeValuesFrom(obo:RO_0000056 obo:HMDM_0000126))

# Class: obo:HMDM_0000012 (gene family)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000012 "A gene family is a set of several similar genes with respect to structure, function, and origin.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000012 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000012 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000012 "HMDM:0000012")
AnnotationAssertion(rdfs:label obo:HMDM_0000012 "gene family")
SubClassOf(obo:HMDM_0000012 obo:HMDM_0000008)

# Class: obo:HMDM_0000015 (mechanism)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000015 "Any chemical reaction or series of reactions, often enzyme-mediated, which result in a physiologic effect.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000015 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000015 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000015 "HMDM:0000015")
AnnotationAssertion(rdfs:label obo:HMDM_0000015 "mechanism")
SubClassOf(obo:HMDM_0000015 obo:HMDM_0000008)

# Class: obo:HMDM_0000016 (antiviral inactivation)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000016 "The process of rendering antiviral medication ineffective. This can be done through various mechanisms.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000016 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000016 "human_microbiome_drug_metabolism_ontology")
