SubClassOf(obo:HMDM_0000022 obo:HMDM_0000021)

# Class: obo:HMDM_0000023 (Enterococcus faecalis tyrosine decarboxylase (TDC))

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:25529314") Annotation(oboInOwl:hasDbXref "PMID:30659181") Annotation(oboInOwl:hasDbXref "PMID:31196984") obo:IAO_0000115 obo:HMDM_0000023 "Tyrosine decarboxylase (TDC) is an enzyme with the ability to decarboxylate L-tyrosine into tyramine. Due to the structural similarities between tyrosine and levodopa, TDC found in small intestinal bacteria can convert levodopa to dopamine. Moreover, commonly used decarboxylase inhibitors, carbidopa, benserazide, and methyldopa, do not inhibit TDC. This reduces the efficacy of the drug since the conversion of levodopa to dopamine occurs outside the brain.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000023 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000023 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000023 "HMDM:0000023")
AnnotationAssertion(rdfs:label obo:HMDM_0000023 "Enterococcus faecalis tyrosine decarboxylase (TDC)")
SubClassOf(obo:HMDM_0000023 obo:HMDM_0000092)
SubClassOf(obo:HMDM_0000023 ObjectSomeValuesFrom(obo:MI_1140 obo:CHEBI_15765))
SubClassOf(obo:HMDM_0000023 ObjectSomeValuesFrom(obo:RO_0000056 obo:HMDM_0000125))

