SubClassOf(<http://purl.obolibrary.org/obo/HMDM_0000784> <http://purl.obolibrary.org/obo/HMDM_0000782>)

# Class: <http://purl.obolibrary.org/obo/HMDM_0000785> (<http://purl.obolibrary.org/obo/HMDM_0000785>)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16011758") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34613761") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HMDM_0000785> "Nitroreductases are a family of evolutionarily related proteins involved in reducing nitroaromatic and nitroheterocyclic compounds using flavin adenine dinucleotide (FAD) or flavin mononucleotide (FMN) as the cofactor and NAD(P)H as a reducing equivalent. Nitroreductases catalyse pyridine nucleotide-dependent reduction of nitroaromatics compounds, showing significant human health and environmental implications.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/HMDM_0000785> "human_microbiome_drug_metabolism")
