# Class: <http://purl.obolibrary.org/obo/CHEBI_49662> (<http://purl.obolibrary.org/obo/CHEBI_49662>)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_49662> "A member of the class of indole-3-acetic acids that is indole-3-acetic acid in which the indole ring is substituted at positions 1, 2 and 5 by p-chlorobenzoyl, methyl, and methoxy groups, respectively. A non-steroidal anti-inflammatory drug, it is used in the treatment of musculoskeletal and joint disorders including osteoarthritis, rheumatoid arthritis, gout, bursitis and tendinitis.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/CHEBI_49662> "human_microbiome_drug_metabolism")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CHEBI_49662> "CHEBI:49662")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_49662> <http://purl.obolibrary.org/obo/HMDM_0000002>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_4974> (<http://purl.obolibrary.org/obo/CHEBI_4974>)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_4974> "2-Amino-9H-purine in which the hydrogen at position 9 is substituted by a 4-acetoxy-3-(acetoxymethyl)but-1-yl group. A prodrug of the antiviral penciclovir, it is used for the treatment of acute herpes zoster (shingles), for the treatment or suppression of recurrent genital herpes in immunocompetent patients and for the treatment of recurrent mucocutaneous herpes simplex infections in HIV infected patients.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/CHEBI_4974> "human_microbiome_drug_metabolism")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CHEBI_4974> "CHEBI:4974")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_4974> <http://purl.obolibrary.org/obo/HMDM_0000002>)
