# Class: obo:HMDM_0000240 (NADH oxidase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:10629192") Annotation(oboInOwl:hasDbXref "PMID:27737924") obo:IAO_0000115 obo:HMDM_0000240 "NADH oxidase (NOX) is a member of the flavoprotein disulfide reductase family that catalyses the pyridine-nucleotide-dependent reduction of various substrates, including O2, H2O2 and thioredoxin. NADH oxidases (NOXs) catalysing the oxidation of NADH to yield NAD+ and H2O, H2O2, or both play an important role in protecting organisms from oxidative stress and maintaining the balance of NAD+/NADH.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000240 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000240 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000240 "HMDM:0000240")
AnnotationAssertion(rdfs:label obo:HMDM_0000240 "NADH oxidase")
SubClassOf(obo:HMDM_0000240 obo:HMDM_0000264)

# Class: obo:HMDM_0000261 (anti-parkinson agent)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:30661251") Annotation(oboInOwl:hasDbXref "PMID:35601911") obo:IAO_0000115 obo:HMDM_0000261 "Parkinson’s disease (PD) is characterized by prodromal symptoms, motor difficulties, and psychological or cognitive problems. As a progressive neurodegenerative disease, PD causes focal degeneration of midbrain dopamine (MesDA) neurons. Antiparkinson agents are agents used for treatment of Parkinson’s disease. Medications, include dopamine agonists, monoamine oxidase B inhibitors, levodopa plus carbidopa, etc., anticholinergics and amantadine. Also, new theraputic approaches include, based on recent advances in the understanding of the pathophysiology of Parkinson’s disease, genetic and disease-modifying approaches to reduce abnormal accumulation and aggregation of alpha-synuclein (aSYN), mitochondrial dysfunction, and dysfunction of lysosomal proteins, as well as approaches to reduce neuroinflammation and increase neurorestoration.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000261 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000261 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000261 "HMDM:0000261")
AnnotationAssertion(rdfs:label obo:HMDM_0000261 "anti-parkinson agent")
SubClassOf(obo:HMDM_0000261 obo:HMDM_0000073)

# Class: obo:HMDM_0000264 (Flavoenzymes)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:10494549") obo:IAO_0000115 obo:HMDM_0000264 "Flavoenzymes are redox proteins that catalyze a wide diversity of biological reactions ranging from O2 activation, to aromatic hydroxylations, dehydrogenations, and reactions in which they can accept or donate one or two electrons.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000264 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000264 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000264 "HMDM:0000264")
AnnotationAssertion(rdfs:label obo:HMDM_0000264 "Flavoenzymes")
SubClassOf(obo:HMDM_0000264 obo:HMDM_0000012)

# Class: obo:HMDM_0000265 (FMN-dependent NADH azoreductase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:18791262") Annotation(oboInOwl:hasDbXref "PMID:27487252") obo:IAO_0000115 obo:HMDM_0000265 "Azoreductases reduce the azo bond (N=N) in azo dyes to produce colorless amine products. FMN-dependent NADH azoreductase are flavin-dependent, specifically flavin mononucleotide (FMN) enzymes, that are able to reductively cleave compounds containing an azo bond and where NADH is used as an electron donor for the reduction of substrates by azoreductases.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000265 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000265 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000265 "HMDM:0000265")
AnnotationAssertion(rdfs:label obo:HMDM_0000265 "FMN-dependent NADH azoreductase")
SubClassOf(obo:HMDM_0000265 obo:HMDM_0000264)

# Class: obo:HMDM_0000266 (FMN-dependent NAD(P)H nitroreductase)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000266 "The FMN-dependent NAD(P)H nitroreductase catalyze the sequential reduction of nitro groups through the addition of electron pairs from NAD(P)H and flavin mononucleotide (FMN) .")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000266 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000266 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000266 "HMDM:0000266")
AnnotationAssertion(rdfs:label obo:HMDM_0000266 "FMN-dependent NAD(P)H nitroreductase")
SubClassOf(obo:HMDM_0000266 obo:HMDM_0000264)

# Class: obo:HMDM_0000269 (FMN-dependent Nitroreductase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:15184374") Annotation(oboInOwl:hasDbXref "PMID:34613761") obo:IAO_0000115 obo:HMDM_0000269 "Nitroreductases are a family of evolutionarily related proteins involved in reducing nitroaromatic and nitroheterocyclic compounds. FMN-dependent Nitroreductase uses flavin mononucleotide (FMN) as the cofactor in this reaction. FMN usually works as a prosthetic groups in flavoproteins to which they are tightly bound. Flavodoxins are small monomeric flavoproteins (15–22 kDa) that noncovalently bind a single FMN molecule, acting as a redox center. The flavodoxin scaffold contributes to the mechanism of electron transfer by stabilizing the FMN molecule in an environment that promotes the highly negative redox potential required for its biochemical activity.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000269 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000269 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000269 "HMDM:0000269")
AnnotationAssertion(rdfs:label obo:HMDM_0000269 "FMN-dependent Nitroreductase")
SubClassOf(obo:HMDM_0000269 obo:HMDM_0000264)

# Class: obo:HMDM_0000270 (FMN-dependent NADPH nitroreductase)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:28545445") Annotation(oboInOwl:hasDbXref "PMID:34613761") obo:IAO_0000115 obo:HMDM_0000270 "Oxygen-insensitive nitroreductases are a group of flavoenzymes, belonging to oxido-reductases, that are able to reduce nitro compounds depending on nicotinamide adenine dinucleotide availability (NAD(P)H). Nitroreductases were separated of others reductases due to their capacity to reduce nitro compounds. FMN-dependent NADPH nitroreductase uses flavin mononucleotide (FMN) as the cofactor and NADPH as a reducing equivalent.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000270 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000270 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000270 "HMDM:0000270")
AnnotationAssertion(rdfs:label obo:HMDM_0000270 "FMN-dependent NADPH nitroreductase")
SubClassOf(obo:HMDM_0000270 obo:HMDM_0000264)

# Class: obo:HMDM_0000271 (Acyltransferase)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000271 "Acyltransferase or transacylase utilize these activated acyl chains and transfer them to a variety of different substrates or polymerize them.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000271 <https://orcid.org/0000-0001-9259-5280>)
