AnnotationAssertion(rdfs:label obo:HMDM_0000097 "cytochrome protein family")
SubClassOf(obo:HMDM_0000097 obo:HMDM_0000012)

# Class: obo:HMDM_0000098 (cardiac therapy metabolism)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000098 "The process of breaking down of a cardiac therapy drug which improve the heart's energy production and efficiency.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000098 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000098 "human_microbiome_drug_metabolism_ontology")
