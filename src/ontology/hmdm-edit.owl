SubClassOf(obo:HMDM_0000784 obo:HMDM_0000782)

# Class: obo:HMDM_0000785 (Nitroreductases)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:16011758") Annotation(oboInOwl:hasDbXref "PMID:34613761") obo:IAO_0000115 obo:HMDM_0000785 "Nitroreductases are a family of evolutionarily related proteins involved in reducing nitroaromatic and nitroheterocyclic compounds using flavin adenine dinucleotide (FAD) or flavin mononucleotide (FMN) as the cofactor and NAD(P)H as a reducing equivalent. Nitroreductases catalyse pyridine nucleotide-dependent reduction of nitroaromatics compounds, showing significant human health and environmental implications.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000785 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000785 "human_microbiome_drug_metabolism_ontology")
