SubClassOf(<http://purl.obolibrary.org/obo/HMDM_0000022> <http://purl.obolibrary.org/obo/HMDM_0000021>)

# Class: <http://purl.obolibrary.org/obo/HMDM_0000023> (<http://purl.obolibrary.org/obo/HMDM_0000023>)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25529314") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30659181") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31196984") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HMDM_0000023> "Tyrosine decarboxylase (TDC) is an enzyme with the ability to decarboxylate L-tyrosine into tyramine. Due to the structural similarities between tyrosine and levodopa, TDC found in small intestinal bacteria can convert levodopa to dopamine. Moreover, commonly used decarboxylase inhibitors, carbidopa, benserazide, and methyldopa, do not inhibit TDC. This reduces the efficacy of the drug since the conversion of levodopa to dopamine occurs outside the brain.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/HMDM_0000023> "human_microbiome_drug_metabolism")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HMDM_0000023> "HMDM:0000023")
SubClassOf(<http://purl.obolibrary.org/obo/HMDM_0000023> <http://purl.obolibrary.org/obo/HMDM_0000092>)
SubClassOf(<http://purl.obolibrary.org/obo/HMDM_0000023> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/MI_1140> <http://purl.obolibrary.org/obo/CHEBI_15765>))
SubClassOf(<http://purl.obolibrary.org/obo/HMDM_0000023> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000056> <http://purl.obolibrary.org/obo/HMDM_0000125>))

