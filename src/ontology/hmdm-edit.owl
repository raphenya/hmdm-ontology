# Class: <http://purl.obolibrary.org/obo/HMDM_0000793> (<http://purl.obolibrary.org/obo/HMDM_0000793>)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11937512") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34819672") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HMDM_0000793> "A self-resistance mechanism is encoded within the biosynthetic gene cluster (BGC) for acarbose (acb) production; a specific kinase, AcbK, phosphorylates acarbose at the O6A hydroxyl and renders it inactive.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/HMDM_0000793> "human_microbiome_drug_metabolism")
