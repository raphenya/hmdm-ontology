SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_42098> <http://purl.obolibrary.org/obo/HMDM_0000002>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_42797> (<http://purl.obolibrary.org/obo/CHEBI_42797>)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_42797> "A γ-amino acid that is cyclohexane substituted at position 1 by aminomethyl and carboxymethyl groups. Used for treatment of neuropathic pain and restless legs syndrome.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/CHEBI_42797> "human_microbiome_drug_metabolism")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CHEBI_42797> "CHEBI:42797")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_42797> <http://purl.obolibrary.org/obo/HMDM_0000002>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_4315> (<http://purl.obolibrary.org/obo/CHEBI_4315>)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_4315> "Danazol is a medication used in the treatment of endometriosis, fibrocystic breast disease, hereditary angioedema and other conditions. A compound which inhibits or antagonises the biosynthesis or actions of estrogens.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/CHEBI_4315> "human_microbiome_drug_metabolism")
