SubClassOf(obo:HMDM_0000020 obo:HMDM_0000019)

# Class: obo:HMDM_0000021 (central nervous system agent)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:16489364") Annotation(oboInOwl:hasDbXref "PMID:27439371") obo:IAO_0000115 obo:HMDM_0000021 "The central nervous system agents are medicines that affect the central nervous system (CNS). There are many different types of drugs that work on the CNS, including anesthetics, anticonvulsants, antiemetics, antiparkinson agents, CNS stimulants, muscle relaxants, narcotic analgesics (pain relievers), nonnarcotic analgesics (such as acetaminophen and NSAIDs), and sedatives. Features of CNS drugs are related to their ability to penetrate the blood-brain barrier affinity and exhibit CNS activity and can be used in the management of neuro degenerative and psychiatric problems.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000021 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000021 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000021 "HMDM:0000021")
AnnotationAssertion(rdfs:label obo:HMDM_0000021 "central nervous system agent")
SubClassOf(obo:HMDM_0000021 obo:HMDM_0000073)
SubClassOf(obo:HMDM_0000021 obo:HMDM_0000488)

# Class: obo:HMDM_0000022 (dopamine precursor)

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000022 "A chemical compound that participates in a chemical reaction that produces dopamine.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000022 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000022 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000022 "HMDM:0000022")
AnnotationAssertion(rdfs:label obo:HMDM_0000022 "dopamine precursor")
SubClassOf(obo:HMDM_0000022 obo:HMDM_0000021)

# Class: obo:HMDM_0000023 (Enterococcus faecalis tyrosine decarboxylase (TDC))

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:25529314") Annotation(oboInOwl:hasDbXref "PMID:30659181") Annotation(oboInOwl:hasDbXref "PMID:31196984") obo:IAO_0000115 obo:HMDM_0000023 "Tyrosine decarboxylase (TDC) is an enzyme with the ability to decarboxylate L-tyrosine into tyramine. Due to the structural similarities between tyrosine and levodopa, TDC found in small intestinal bacteria can convert levodopa to dopamine. Moreover, commonly used decarboxylase inhibitors, carbidopa, benserazide, and methyldopa, do not inhibit TDC. This reduces the efficacy of the drug since the conversion of levodopa to dopamine occurs outside the brain.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000023 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000023 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000023 "HMDM:0000023")
AnnotationAssertion(rdfs:label obo:HMDM_0000023 "Enterococcus faecalis tyrosine decarboxylase (TDC)")
SubClassOf(obo:HMDM_0000023 obo:HMDM_0000092)
SubClassOf(obo:HMDM_0000023 ObjectSomeValuesFrom(obo:MI_1140 obo:CHEBI_15765))
SubClassOf(obo:HMDM_0000023 ObjectSomeValuesFrom(obo:RO_0000056 obo:HMDM_0000125))

