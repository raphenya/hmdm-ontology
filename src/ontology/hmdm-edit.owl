SubClassOf(obo:HMDM_0000271 obo:HMDM_0000012)

# Class: obo:HMDM_0000272 (Arylamine N-acetyltransferases (NATs))

AnnotationAssertion(obo:IAO_0000115 obo:HMDM_0000272 "Arylamine N-acetyltransferases (NATs) are polymorphic drug-metabolizing enzymes, acetylating arylamine carcinogens and drugs including hydralazine and sulphonamides.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000272 <https://orcid.org/0000-0001-9259-5280>)
