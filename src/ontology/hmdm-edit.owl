# Class: obo:HMDM_0000094 (lyases family)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:21417217") obo:IAO_0000115 obo:HMDM_0000094 "Lyases are enzymes that catalyze the bond construction and breaking by means other than hydrolysis or redox reactions. Such enzymes are particular in the sense that they only require one substrate for the reaction in one direction, but two substrates for the reverse reaction.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000094 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000094 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000094 "HMDM:0000094")
AnnotationAssertion(rdfs:label obo:HMDM_0000094 "lyases family")
SubClassOf(obo:HMDM_0000094 obo:HMDM_0000012)
SubClassOf(obo:HMDM_0000094 obo:HMDM_0000896)

# Class: obo:HMDM_0000095 (Cytochrome c-type protein)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:24637603") obo:IAO_0000115 obo:HMDM_0000095 "These proteins are part of cardiac glycoside reductase (CGR) pathway. The CGR is responsible for reductive metabolism of cardiac glycoside. The expression of these enzymes can be inhibited by dietary arginine.")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000095 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000095 "human_microbiome_drug_metabolism_ontology")
