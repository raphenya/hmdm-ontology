# Class: obo:HMDM_0000490 (calcium channel blockers)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:21896151") Annotation(oboInOwl:hasDbXref "PMID:8680353") obo:IAO_0000115 obo:HMDM_0000490 "Calcium ions are essential for the chain of events that leads to myocardial contraction. Its role in the cardiac cycle has been studied extensively for years. Calcium is thought to be effective in slow channels. Calcium channel blockers (CCBs) inhibit the flow of extracellular calcium through ion‐specific channels that span the cell wall. When inward calcium flux is inhibited, vascular smooth muscle cells relax, resulting in vasodilation and a lowering of blood pressure (BP).")
AnnotationAssertion(dcterms:contributor obo:HMDM_0000490 <https://orcid.org/0000-0001-9259-5280>)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:HMDM_0000490 "human_microbiome_drug_metabolism_ontology")
AnnotationAssertion(oboInOwl:id obo:HMDM_0000490 "HMDM:0000490")
AnnotationAssertion(rdfs:label obo:HMDM_0000490 "calcium channel blockers")
SubClassOf(obo:HMDM_0000490 obo:HMDM_0000073)
SubClassOf(obo:HMDM_0000490 ObjectSomeValuesFrom(obo:RO_0000056 obo:HMDM_0000489))

