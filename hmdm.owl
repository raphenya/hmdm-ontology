        <oboInOwl:id>CHEBI:50864</oboInOwl:id>
        <rdfs:label>insulin-sensitizing drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50900 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50900">
