    <!-- http://purl.obolibrary.org/obo/CHEBI_75325 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75325">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_52208"/>
        <obo:IAO_0000115>Any substance that accelerates defecation. Compare with laxatives, which are substances that ease defecation (usually by softening faeces). A substance can be both a laxative and a cathartic.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:75325</oboInOwl:id>
