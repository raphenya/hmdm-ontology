        <oboInOwl:hasOBONamespace>human_microbiome_drug_metabolism_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>HMDM:0000271</oboInOwl:id>
        <rdfs:label>Acyltransferase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HMDM_0000272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HMDM_0000272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HMDM_0000271"/>
        <obo:IAO_0000115>Arylamine N-acetyltransferases (NATs) are polymorphic drug-metabolizing enzymes, acetylating arylamine carcinogens and drugs including hydralazine and sulphonamides.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9259-5280"/>
        <oboInOwl:hasOBONamespace>human_microbiome_drug_metabolism_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>HMDM:0000272</oboInOwl:id>
        <rdfs:label>Arylamine N-acetyltransferases (NATs)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HMDM_0000274 -->

