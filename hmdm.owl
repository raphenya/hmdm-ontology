    <!-- http://purl.obolibrary.org/obo/CHEBI_49200 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_49200">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76895"/>
        <obo:IAO_0000115>An EC 3.6.3.* (acid anhydride hydrolase catalysing transmembrane movement of substances) inhibitor that inhibits H&lt;small&gt;&lt;sup&gt;+&lt;/small&gt;&lt;/sup&gt;/K&lt;small&gt;&lt;sup&gt;+&lt;/small&gt;&lt;/sup&gt;-exchanging ATPase, EC 3.6.3.10. Such compounds are also known as proton pump inhibitors.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:49200</oboInOwl:id>
        <rdfs:label>EC 3.6.3.10 (H(+)/K(+)-exchanging ATPase) inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_49201 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_49201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>One of various classes of drugs with different action mechanisms used to treat or ameliorate peptic ulcer or irritation of the gastrointestinal tract.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:49201</oboInOwl:id>
        <rdfs:label>anti-ulcer drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_49205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_49205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35222"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_52206"/>
        <obo:IAO_0000115>Any inhibitor of cholesterylester transfer protein (CETP), which transfers cholesterol from high density lipoproteins (HDL, the &apos;good&apos; cholesterol-containing particles) to low or very low density lipoproteins (LDL or VLDL, the &apos;bad&apos; cholesterol-containing particles). Inhibition of this process results in higher HDL levels and lower LDL levels. CETP inhibitors are under investigation as potential drugs to reduce the risk of arteriosclerotic vascular disease (atherosclerosis).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:49205</oboInOwl:id>
        <rdfs:label>CETP inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_49322 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_49322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48120"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33281"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An organic compound that has a tetrahydronaphthacenedione ring structure attached by a glycosidic linkage to the amino sugar daunosamine and which exhibits antibiotic activity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:49322</oboInOwl:id>
        <rdfs:label>anthracycline antibiotic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_49323 -->

