    <!-- http://purl.obolibrary.org/obo/CHEBI_9112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_9112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36145"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_84154"/>
        <obo:IAO_0000115>A member of the class of sennosides that is &lt;em&gt;rel&lt;/em&gt;-(9&lt;i&gt;R&lt;/i&gt;,9&apos;&lt;i&gt;R&lt;/i&gt;)-9,9&apos;,10,10&apos;-tetrahydro-9,9&apos;-bianthracene-2,2&apos;-dicarboxylic acid which is substituted by hydroxy groups at positions 4 and 4&apos;, by β-&lt;small&gt;D&lt;/small&gt;-glucopyranosyloxy groups at positions 5 and 5&apos;, and by oxo groups at positions 10 and 10&apos;. The exact stereochemisty at positions 9 and 9&apos; is not known - it may be &lt;i&gt;R&lt;/i&gt;,&lt;i&gt;R&lt;/i&gt; (as shown) or &lt;i&gt;S&lt;/i&gt;,&lt;i&gt;S&lt;/i&gt;.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:9112</oboInOwl:id>
        <rdfs:label>sennoside A</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_9123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_9123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23697"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36786"/>
