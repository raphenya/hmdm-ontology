            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The enzymes which catalyze the reversible phosphorolysis of pyrimidine nucleosides are involved in the degradation of these compounds and in their utilization as carbon and energy sources, or in the rescue of pyrimidine bases for nucleotide synthesis.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9259-5280"/>
        <oboInOwl:hasOBONamespace>human_microbiome_drug_metabolism_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>HMDM:0000010</oboInOwl:id>
        <rdfs:label>Escherichia coli thymidine phosphorylase (deoA)</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HMDM_0000010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The enzymes which catalyze the reversible phosphorolysis of pyrimidine nucleosides are involved in the degradation of these compounds and in their utilization as carbon and energy sources, or in the rescue of pyrimidine bases for nucleotide synthesis.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:32526207</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:34260950</oboInOwl:hasDbXref>
    </owl:Axiom>
    


