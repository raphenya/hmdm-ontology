                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33575"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any carboxylic ester resulting from the formal condensation of the carboxy group of a carboxylic acid with ethanol.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:23990</oboInOwl:id>
        <rdfs:label>ethyl ester</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_24020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_24020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33229"/>
        <obo:IAO_0000115>Any vitamin that dissolves in fats and are stored in body tissues. Unlike the water-soluble vitamins, they are stored in the body for long periods of time and generally pose a greater risk for toxicity when consumed in excess.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:24020</oboInOwl:id>
        <rdfs:label>fat-soluble vitamin (role)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_24026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_24026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_30879"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_61697"/>
        <obo:IAO_0000115>An aliphatic alcohol consisting of a chain of 3 to greater than 27 carbon atoms. Fatty alcohols may be saturated or unsaturated and may be branched or unbranched.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:24026</oboInOwl:id>
        <rdfs:label>fatty alcohol</rdfs:label>
    </owl:Class>
    


