        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35820"/>
        <obo:IAO_0000115>An antiparasitic drug which is effective against Apicomplexan parasites in the genus &lt;em&gt;Plasmodium&lt;/em&gt;. The genus contains over 200 species and includes those responsible for malaria.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:64915</oboInOwl:id>
        <rdfs:label>antiplasmodial drug</rdfs:label>
    </owl:Class>
    


