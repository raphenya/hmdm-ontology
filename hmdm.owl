        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33653"/>
        <obo:IAO_0000115>An aliphatic compound having a carbocyclic ring structure which may be saturated or unsaturated, but may not be a benzenoid or other aromatic system.</obo:IAO_0000115>
