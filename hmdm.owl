                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37806"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A penicillanic acid compound having a (6&lt;i&gt;R&lt;/i&gt;)-amino substituent. The active nucleus common to all penicillins, it may be substituted at the 6-amino position to form the semisynthetic penicillins, resulting in a variety of antibacterial and pharmacologic characteristics.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:16705</oboInOwl:id>
        <rdfs:label>6-aminopenicillanic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_167095 -->

