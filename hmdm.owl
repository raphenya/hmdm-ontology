        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35681"/>
        <obo:IAO_0000115>A fatty alcohol consisting of a chain of 3 to greater than 27 carbon atoms in which a hydroxy group is attached to a saturated carbon atom different from the terminal carbons. Secondary fatty alcohols may be saturated or unsaturated and may be branched or unbranched.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:167095</oboInOwl:id>
