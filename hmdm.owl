    <!-- http://purl.obolibrary.org/obo/CHEBI_50265 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50264"/>
        <obo:IAO_0000115>Heterocyclic compound of a ring with sulfur and two nitrogen atoms fused to a benzene ring. Members inhibit sodium-potassium-chloride symporters and are used as diuretics.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50265</oboInOwl:id>
        <rdfs:label>benzothiadiazine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50266 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50266">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_136859"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>A compound that, on administration, must undergo chemical conversion by metabolic processes before becoming the pharmacologically active drug for which it is a prodrug.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50266</oboInOwl:id>
        <rdfs:label>prodrug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>Synthetic or natural substance which is given to prevent a disease or disorder or are used in the process of treating a disease or injury due to a poisonous agent.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50267</oboInOwl:id>
        <rdfs:label>protective agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38632"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51374"/>
        <obo:IAO_0000115>A substance that does not act as agonist or antagonist but does affect the gamma-aminobutyric acid receptor-ionophore complex. GABA-A receptors appear to have at least three allosteric sites at which modulators act: a site at which benzodiazepines act by increasing the opening frequency of gamma-aminobutyric acid-activated chloride channels; a site at which barbiturates act to prolong the duration of channel opening; and a site at which some steroids may act.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50268</oboInOwl:id>
        <rdfs:label>GABA modulator</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50275 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_77260"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37956"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
