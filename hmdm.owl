        <obo:IAO_0000115>The α-amino-acid anion resulting from the removal of the proton from the carboxylic acid group of &lt;small&gt;L&lt;/small&gt;-thyroxine.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:60302</oboInOwl:id>
        <rdfs:label>L-thyroxine(1-)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_60311 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_60311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24621"/>
        <obo:IAO_0000115>Any hormone produced by the thyroid gland</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:60311</oboInOwl:id>
        <rdfs:label>thyroid hormone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_60466 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_60466">
