    <!-- http://purl.obolibrary.org/obo/CHEBI_33662 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33662">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33664"/>
        <obo:IAO_0000115>A mancude monocyclic hydrocarbon without side chains of the general formula C&lt;small&gt;&lt;sub&gt;&lt;em&gt;n&lt;/em&gt;&lt;/sub&gt;&lt;/small&gt;H&lt;small&gt;&lt;sub&gt;&lt;em&gt;n&lt;/em&gt;&lt;/sub&gt;&lt;/small&gt; (&lt;em&gt;n&lt;/em&gt; is an even number) or C&lt;small&gt;&lt;sub&gt;&lt;em&gt;n&lt;/em&gt;&lt;/sub&gt;&lt;/small&gt;H&lt;small&gt;&lt;sub&gt;&lt;em&gt;n&lt;/em&gt;+1&lt;/sub&gt;&lt;/small&gt; (&lt;em&gt;n&lt;/em&gt; is an odd number). In systematic nomenclature an annulene with seven or more carbon atoms may be named [&lt;em&gt;n&lt;/em&gt;]annulene, where &lt;em&gt;n&lt;/em&gt; is the number of carbon atoms.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:33662</oboInOwl:id>
        <rdfs:label>annulene</rdfs:label>
    </owl:Class>
    


