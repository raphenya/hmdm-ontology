        <obo:IAO_0000115>A compound consisting of carbon and hydrogen only.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:24632</oboInOwl:id>
        <rdfs:label>hydrocarbon</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_24651 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_24651">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25806"/>
