            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Zwitterionic form of a polar amino acid having an anionic carboxy group and a protonated amino group.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:62031</oboInOwl:id>
