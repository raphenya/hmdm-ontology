        <rdfs:label>anti-protozoal agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HMDM_0000783 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HMDM_0000783">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HMDM_0000777"/>
        <obo:IAO_0000115>An agent used to inhibit or kill parasitic worms.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9259-5280"/>
        <oboInOwl:hasOBONamespace>human_microbiome_drug_metabolism_ontology</oboInOwl:hasOBONamespace>
