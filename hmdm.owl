    <!-- http://purl.obolibrary.org/obo/CHEBI_50112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24621"/>
        <obo:IAO_0000115>Any hormone that is responsible for controlling sexual characteristics and reproductive function.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50112</oboInOwl:id>
        <rdfs:label>sex hormone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50112"/>
        <obo:IAO_0000115>A sex hormone that stimulates or controls the development and maintenance of masculine characteristics in vertebrates by binding to androgen receptors.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50113</oboInOwl:id>
        <rdfs:label>androgen</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50114 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50112"/>
        <obo:IAO_0000115>A hormone that stimulates or controls the development and maintenance of female sex characteristics in mammals by binding to oestrogen receptors. The oestrogens are named for their importance in the oestrous cycle. The oestrogens that occur naturally in the body, notably estrone, estradiol, estriol, and estetrol are steroids. Other compounds with oestrogenic activity are produced by plants (phytoestrogens) and fungi (mycoestrogens); synthetic compounds with oestrogenic activity are known as xenoestrogens.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50114</oboInOwl:id>
        <rdfs:label>estrogen</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50126 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50126">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50699"/>
        <obo:IAO_0000115>An oligosaccharide comprising four monomeric monosaccharide units.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50126</oboInOwl:id>
        <rdfs:label>tetrasaccharide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50176 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50177"/>
        <obo:IAO_0000115>A drug that softens, separates, and causes desquamation of the cornified epithelium or horny layer of skin. Keratolytic drugs are used to expose mycelia of infecting fungi or to treat corns, warts, and certain other skin diseases.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50176</oboInOwl:id>
        <rdfs:label>keratolytic drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>A drug used to treat or prevent skin disorders or for the routine care of skin.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50177</oboInOwl:id>
        <rdfs:label>dermatologic drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76898"/>
        <obo:IAO_0000115>An enzyme inhibitor that interferes with the activity of cytochrome P450 involved in catalysis of organic substances.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50183</oboInOwl:id>
        <rdfs:label>P450 inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38632"/>
        <obo:IAO_0000115>A compound which inhibits the movement of an ion across an energy-transducing cell membrane.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50184</oboInOwl:id>
        <rdfs:label>ion transport inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50218 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50218">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76760"/>
        <obo:IAO_0000115>An EC 3.1.* (ester hydrolase) inhibitor that interferes with the action of a phosphoric diester hydrolase (EC 3.1.4.*).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50218</oboInOwl:id>
        <rdfs:label>EC 3.1.4.* (phosphoric diester hydrolase) inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50267"/>
        <obo:IAO_0000115>Any protective agent counteracting or neutralizing the action of poisons.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50247</oboInOwl:id>
