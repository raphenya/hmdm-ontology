                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0018033"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64214"/>
            </owl:Restriction>
        </rdfs:subClassOf>
