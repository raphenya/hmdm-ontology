        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22587"/>
        <obo:IAO_0000115>An antiviral agent that destroys or inhibits the replication of the human immunodeficiency virus.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:64946</oboInOwl:id>
        <rdfs:label>anti-HIV agent</rdfs:label>
    </owl:Class>
    


