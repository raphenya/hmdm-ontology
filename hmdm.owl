    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75603 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75603">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23924"/>
        <obo:IAO_0000115>Any enzyme inhibitor that interferes with the action of a ligase (EC 6.*.*.*). Ligases are enzymes that catalyse the joining of two molecules with concomitant hydrolysis of the diphosphate bond in ATP or a similar triphosphate.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:75603</oboInOwl:id>
        <rdfs:label>EC 6.* (ligase) inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75604 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75604">
