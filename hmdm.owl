            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A 1,4-benzodiazepinone that is 1,3-dihydro-2&lt;em&gt;H&lt;/em&gt;-1,4-benzodiazepin-2-one which is substituted at positions 5 and 7 by phenyl and nitro groups, respectively. It is used as a hypnotic for the short-term management of insomnia and for the treatment of epileptic spasms in infants (West&apos;s syndrome).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:7581</oboInOwl:id>
