    <!-- http://purl.obolibrary.org/obo/CHEBI_35221 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_52206"/>
        <obo:IAO_0000115>A substance which is structurally similar to a metabolite but which competes with it or replaces it, and so prevents or reduces its normal utilization.</obo:IAO_0000115>
