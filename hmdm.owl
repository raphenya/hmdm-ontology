        <obo:IAO_0000115>An azaspiro compound is a spiro compound in which at least one of the cyclic components is a nitrogen heterocyle.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35624</oboInOwl:id>
        <rdfs:label>azaspiro compound</rdfs:label>
    </owl:Class>
    


