                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_68495"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A member of the class of pyranoindolizinoquinolines that is (4&lt;i&gt;S&lt;/i&gt;)-pyrano[3&apos;,4&apos;:6,7]indolizino[1,2-&lt;em&gt;b&lt;/em&gt;]quinoline-3,14-dione bearing two additional ethyl substituents at positions 4 and 11 as well as two additional hydroxy substituents at positions 4 and 9. It is the active metabolite of irinotecan and is ~1000 times more active than irinotecan itself.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
