            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A member of the class of indole-3-acetic acids that is indole-3-acetic acid in which the indole ring is substituted at positions 1, 2 and 5 by &lt;em&gt;p&lt;/em&gt;-chlorobenzoyl, methyl, and methoxy groups, respectively. A non-steroidal anti-inflammatory drug, it is used in the treatment of musculoskeletal and joint disorders including osteoarthritis, rheumatoid arthritis, gout, bursitis and tendinitis.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:49662</oboInOwl:id>
        <rdfs:label>indometacin</rdfs:label>
    </owl:Class>
    


