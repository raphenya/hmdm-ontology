        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:51372</oboInOwl:id>
        <rdfs:label>neuromuscular agent</rdfs:label>
    </owl:Class>
    


