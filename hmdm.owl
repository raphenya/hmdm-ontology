    <!-- http://purl.obolibrary.org/obo/HMDM_0000793 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HMDM_0000793">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HMDM_0000820"/>
