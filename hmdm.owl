        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25944"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35718"/>
        <obo:IAO_0000115>A substance used to destroy fungal pests.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:24127</oboInOwl:id>
        <rdfs:label>fungicide</rdfs:label>
    </owl:Class>
    


