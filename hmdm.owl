        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64909"/>
        <obo:IAO_0000115>Poisonous substance produced by a biological organism such as a microbe, animal or plant.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:27026</oboInOwl:id>
        <rdfs:label>toxin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33284"/>
        <obo:IAO_0000115>Any nutrient required in small quantities by organisms throughout their life in order to orchestrate a range of physiological functions.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:27027</oboInOwl:id>
        <rdfs:label>micronutrient</rdfs:label>
    </owl:Class>
    


