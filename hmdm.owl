        <obo:IAO_0000115>Amides with the general formula R&lt;small&gt;&lt;sup&gt;1&lt;/small&gt;&lt;/sup&gt;R&lt;small&gt;&lt;sup&gt;2&lt;/small&gt;&lt;/sup&gt;NCHO (R&lt;small&gt;&lt;sup&gt;1&lt;/small&gt;&lt;/sup&gt; and R&lt;small&gt;&lt;sup&gt;2&lt;/small&gt;&lt;/sup&gt; can be H).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:24079</oboInOwl:id>
        <rdfs:label>formamides</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_24127 -->

