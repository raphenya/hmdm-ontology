    <!-- http://purl.obolibrary.org/obo/HMDM_0000782 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HMDM_0000782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HMDM_0000777"/>
        <obo:IAO_0000115>An agent used to inhibit or kill protozoa.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9259-5280"/>
