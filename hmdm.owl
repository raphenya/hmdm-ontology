            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A pyrimidine 2&apos;-deoxyribonucleoside compound having 5-trifluoromethyluracil as the nucleobase. An antiviral drug used mainly in the treatment of primary keratoconjunctivitis and recurrent epithelial keratitis.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:75179</oboInOwl:id>
        <rdfs:label>trifluridine</rdfs:label>
    </owl:Class>
    


