        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_49020"/>
        <obo:IAO_0000115>A drug used to treat hyperthyroidism by reducing the excessive production of thyroid hormones.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50671</oboInOwl:id>
        <rdfs:label>antithyroid drug</rdfs:label>
    </owl:Class>
    


