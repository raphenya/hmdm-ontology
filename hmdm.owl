            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A  morphinane alkaloid found in the opium poppy, &lt;em&gt;Papaver somniferum var. album&lt;/em&gt;; has analgesic, anti-tussive and anti-diarrhoeal properties.</obo:IAO_0000115>
