        <oboInOwl:id>CHEBI:27134</oboInOwl:id>
        <rdfs:label>trimethylxanthine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27136 -->

