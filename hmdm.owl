    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_62761 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_62761">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25985"/>
