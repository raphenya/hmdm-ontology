        <obo:IAO_0000115>An EC 2.7.* (&lt;em&gt;P&lt;/em&gt;-containing group transferase) inhibitor that interferes with the action of protein kinases.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:37699</oboInOwl:id>
        <rdfs:label>protein kinase inhibitor</rdfs:label>
    </owl:Class>
    


