        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:60654</oboInOwl:id>
        <rdfs:label>valproate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_60783 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_60783">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_21731"/>
        <obo:IAO_0000115>An analogue of a nucleoside, being an &lt;em&gt;N&lt;/em&gt;-glycosyl compound in which the nitrogen-containing moiety is a modified nucleotide base. They are commonly used as antiviral products to prevent viral replication in infected cells.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:60783</oboInOwl:id>
        <rdfs:label>nucleoside analogue</rdfs:label>
    </owl:Class>
    


