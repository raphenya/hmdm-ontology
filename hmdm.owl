        <oboInOwl:id>CHEBI:61697</oboInOwl:id>
        <rdfs:label>fatty acid derivative</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_62031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_62031">
