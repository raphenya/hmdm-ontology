    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50509">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50510"/>
        <obo:IAO_0000115>An agent that inhibits cell membrane glycoproteins that are selectively permeable to potassium ions.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50509</oboInOwl:id>
        <rdfs:label>potassium channel blocker</rdfs:label>
    </owl:Class>
    


