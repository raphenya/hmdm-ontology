        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50248"/>
        <obo:IAO_0000115>An agent that prevents blood clotting.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50249</oboInOwl:id>
        <rdfs:label>anticoagulant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50264 -->

