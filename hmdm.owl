    <!-- http://purl.obolibrary.org/obo/CHEBI_64912 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64912">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36047"/>
        <obo:IAO_0000115>A drug used to treat or prevent infections caused by &lt;em&gt;Mycobacteria&lt;/em&gt;, a genus of actinobacteria. Aerobic and nonmotile, members of the genus include the pathogens responsible for causing tuberculosis and leprosy.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:64912</oboInOwl:id>
        <rdfs:label>antimycobacterial drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64915 -->

