            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A  dihydropyridine that is 1,4-dihydropyridine substituted by methyl groups at positions 2 and 6, a 3-nitrophenyl group at position 4, a ethoxycarbonyl group at position 3 and a methoxycarbonyl group at position 5. It is a calcium-channel blocker used in the treatment of hypertension.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:7582</oboInOwl:id>
        <rdfs:label>nitrendipine</rdfs:label>
    </owl:Class>
    


