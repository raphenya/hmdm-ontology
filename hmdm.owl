        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50112"/>
        <obo:IAO_0000115>A compound that interacts with progesterone receptors in target tissues to bring about effects similar to those of progesterone.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50745</oboInOwl:id>
        <rdfs:label>progestogen</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50748 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50748">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50177"/>
        <obo:IAO_0000115>A drug used to treat psoriasis.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50748</oboInOwl:id>
        <rdfs:label>antipsoriatic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50750 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50750">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_70727"/>
        <obo:IAO_0000115>A topoisomerase inhibitor that inhibits DNA topoisomerase (ATP-hydrolysing), EC 5.99.1.3 (also known as topoisomerase II and as DNA gyrase), which catalyses ATP-dependent breakage of both strands of DNA, passage of the unbroken strands through the breaks, and rejoining of the broken strands.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50750</oboInOwl:id>
        <rdfs:label>EC 5.99.1.3 [DNA topoisomerase (ATP-hydrolysing)] inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50751 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50751">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>A drug which acts to reduce estrogenic activity in the body, either by reducing the amount of estrogen or by reducing the activity of whatever estrogen is present.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50751</oboInOwl:id>
        <rdfs:label>anti-estrogen</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50753 -->

