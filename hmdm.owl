        <oboInOwl:id>CHEBI:35259</oboInOwl:id>
        <rdfs:label>benzofurans</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25697"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35274"/>
        <obo:IAO_0000115>A derivative of ammonium, NH&lt;small&gt;&lt;sub&gt;4&lt;/sub&gt;&lt;/small&gt;&lt;small&gt;&lt;sup&gt;+&lt;/small&gt;&lt;/sup&gt;, in which all four of the hydrogens bonded to nitrogen have been replaced with univalent (usually organyl) groups.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35267</oboInOwl:id>
        <rdfs:label>quaternary ammonium ion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35273 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26469"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_46850"/>
        <obo:IAO_0000115>Derivatives of ammonium compounds, (NH&lt;small&gt;&lt;sub&gt;4&lt;/sub&gt;&lt;/small&gt;&lt;small&gt;&lt;sup&gt;+&lt;/small&gt;&lt;/sup&gt;)Y&lt;small&gt;&lt;sup&gt;−&lt;/small&gt;&lt;/sup&gt;, in which all four of the hydrogens bonded to nitrogen have been replaced with univalent (usually organyl) groups.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35273</oboInOwl:id>
        <rdfs:label>quaternary ammonium salt</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35274 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33702"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51143"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0018040"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28938"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A derivative of ammonium, NH&lt;small&gt;&lt;sub&gt;4&lt;/sub&gt;&lt;/small&gt;&lt;small&gt;&lt;sup&gt;+&lt;/small&gt;&lt;/sup&gt;, in which one (or more) of the hydrogens bonded to the nitrogen have been replaced with univalent organyl groups. The substituting carbon of the organyl group must not itself be directly attached to a heteroatom (thereby excluding protonated amides, hemiaminals, etc).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35274</oboInOwl:id>
        <rdfs:label>ammonium ion derivative</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35276 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35276">
