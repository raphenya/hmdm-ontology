        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22587"/>
        <obo:IAO_0000115>An antiviral agent that destroys or inhibits the replication of the hepatitis B virus.</obo:IAO_0000115>
