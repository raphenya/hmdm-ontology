        <oboInOwl:id>CHEBI:35641</oboInOwl:id>
        <rdfs:label>dibenzannulene</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35642 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35642">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35641"/>
