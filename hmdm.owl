        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The Eggerthella sp. YY7918 tetrahydrodaidzein reductase (thdr), encoded by eqlC, performs the last step the conversion of daidzein to equol. In addition, the enzyme catalyzing the third step (THDR) uses tetrahydrodaidzein as a substrate and produces both equol and dihydrodaidzein in the absence of the reducing coenzyme, NAD(P)H.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:29699942</oboInOwl:hasDbXref>
    </owl:Axiom>
    


