        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51959"/>
        <obo:IAO_0000115>An organic tricyclic compound in which at least one of the rings of the tricyclic skeleton contains one or more heteroatoms.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:26979</oboInOwl:id>
        <rdfs:label>organic heterotricyclic compound</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22712"/>
        <obo:IAO_0000115>Any member of the class of benzenes that is a substituted benzene in which the substituents include one (and only one) methyl group.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:27024</oboInOwl:id>
        <rdfs:label>toluenes</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27026">
