        <obo:IAO_0000115>Any EC 3.1.1.* (carboxylic ester hydrolase) inhibitor that inhibits the action of triacylglycerol lipase (EC 3.1.1.3).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:65001</oboInOwl:id>
