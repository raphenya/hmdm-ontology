        <oboInOwl:hasDbXref>PMID:17904577</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:20057057</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:20417637</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HMDM_0000839 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HMDM_0000839">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HMDM_0000073"/>
        <obo:IAO_0000115>An anti-inflammatory agent is a drug that helps reduce swelling or inflammation.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9259-5280"/>
        <oboInOwl:hasOBONamespace>human_microbiome_drug_metabolism_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>HMDM:0000839</oboInOwl:id>
        <rdfs:label>anti-inflammatory agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HMDM_0000843 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HMDM_0000843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HMDM_0000012"/>
        <obo:IAO_0000115>Phospholipid N-methyltransferase (PLMT) enzymes catalyze the S-adenosylmethionine-dependent methylation of ethanolamine-containing phospholipids to produce phosphatidylcholine. Phosphatidylcholine is the most abundant phospholipid in most non-plastid membranes of eukaryotes and functions as a structural membrane lipid, and as a precursor to important lipid-based signaling molecules. In mammals and fungi, phosphatidylcholine can be formed through two distinct pathways: (a) the “nucleotide pathway” in which free choline is incorporated in phosphatidylcholine using CDP-choline as an intermediate, and (b) the “methylation pathway” whereby phosphatidylcholine is produced directly from phosphatidylethanolamine (PtdEtn) via three sequential methylation reactions using S-adenosylmethionine (AdoMet) as the methyl donor. In plants, phosphatidylcholine biosynthesis occurs through a branched pathway that utilizes components of both the nucleotide and methylation pathways. In mammals, the 18-kDa integral membrane protein phosphatidylethanolamine N-methyltransferase (PEMT) is a PLMT that is expressed primarily in the liver. PEMT catalyzes all three of the methylation reactions needed to convert PtdEtn to phosphatidylcholine.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9259-5280"/>
        <oboInOwl:hasOBONamespace>human_microbiome_drug_metabolism_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>HMDM:0000843</oboInOwl:id>
        <rdfs:label>PEMT (Phospholipid methyltransferase) super family</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HMDM_0000843"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Phospholipid N-methyltransferase (PLMT) enzymes catalyze the S-adenosylmethionine-dependent methylation of ethanolamine-containing phospholipids to produce phosphatidylcholine. Phosphatidylcholine is the most abundant phospholipid in most non-plastid membranes of eukaryotes and functions as a structural membrane lipid, and as a precursor to important lipid-based signaling molecules. In mammals and fungi, phosphatidylcholine can be formed through two distinct pathways: (a) the “nucleotide pathway” in which free choline is incorporated in phosphatidylcholine using CDP-choline as an intermediate, and (b) the “methylation pathway” whereby phosphatidylcholine is produced directly from phosphatidylethanolamine (PtdEtn) via three sequential methylation reactions using S-adenosylmethionine (AdoMet) as the methyl donor. In plants, phosphatidylcholine biosynthesis occurs through a branched pathway that utilizes components of both the nucleotide and methylation pathways. In mammals, the 18-kDa integral membrane protein phosphatidylethanolamine N-methyltransferase (PEMT) is a PLMT that is expressed primarily in the liver. PEMT catalyzes all three of the methylation reactions needed to convert PtdEtn to phosphatidylcholine.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:19366698</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HMDM_0000844 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HMDM_0000844">
