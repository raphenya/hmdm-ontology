    <!-- http://purl.obolibrary.org/obo/HMDM_0000929 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HMDM_0000929">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HMDM_0000097"/>
        <obo:IAO_0000115>The bacterial cytochrome P450 (CYP) family 107 subfamily is a cytochrome P450 monooxygenase family in bacteria, found to be conserved and highly populated in Streptomyces and Bacillus species.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9259-5280"/>
