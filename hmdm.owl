        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:75604</oboInOwl:id>
        <rdfs:label>EC 6.4.* (C-C bond-forming ligase) inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75763 -->

