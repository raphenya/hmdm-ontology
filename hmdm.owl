    <!-- http://purl.obolibrary.org/obo/CHEBI_72544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25806"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50860"/>
        <obo:IAO_0000115>Any organic molecular entity whose stucture is based on derivatives of a phenyl-substituted 1-phenylpropane possessing a C&lt;small&gt;&lt;sub&gt;15&lt;/sub&gt;&lt;/small&gt; or C&lt;small&gt;&lt;sub&gt;16&lt;/sub&gt;&lt;/small&gt; skeleton, or such a structure which is condensed with a C&lt;small&gt;&lt;sub&gt;6&lt;/sub&gt;&lt;/small&gt;-C&lt;small&gt;&lt;sub&gt;3&lt;/sub&gt;&lt;/small&gt; lignan precursors. The term is a &apos;superclass&apos; comprising all members of the classes of flavonoid, isoflavonoid, neoflavonoid, chalcones, dihydrochalcones, aurones, pterocarpan, coumestans, rotenoid, flavonolignan, homoflavonoid and flavonoid oligomers. Originally restricted to natural products, the term is also applied to synthetic compounds related to them.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:72544</oboInOwl:id>
        <rdfs:label>flavonoids</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72588 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72588">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50860"/>
        <obo:IAO_0000115>Any organic molecular entity derived from a natural product by partial chemical synthesis.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:72588</oboInOwl:id>
        <rdfs:label>semisynthetic derivative</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72695 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72695">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25367"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50860"/>
        <obo:IAO_0000115>Any molecule that consists of at least one carbon atom as part of the electrically neutral entity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:72695</oboInOwl:id>
        <rdfs:label>organic molecule</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72773 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35222"/>
        <obo:IAO_0000115>Any inhibitor of the biosynthesis of carotenoids.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:72773</oboInOwl:id>
        <rdfs:label>carotogenesis inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72774 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76859"/>
        <obo:IAO_0000115>An EC 1.3.99.* (oxidoreductase acting on donor CH-CH group with other acceptors) inhibitor that interferes with the action of phytoene desaturase (ζ-carotene-forming), EC 1.3.99.29, an enzyme of carotenoid biosynthesis that converts phytoene into ζ-carotene (zeta-carotene) via the symmetrical introduction of two double bonds at the C-11 and C-11&apos; positions of phytoene.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:72774</oboInOwl:id>
        <rdfs:label>EC 1.3.99.29 [phytoene desaturase (zeta-carotene-forming)] inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75381"/>
        <obo:IAO_0000115>An  EC 1.11.1.* (peroxidases) inhibitor that inhibits the action of &lt;small&gt;L&lt;/small&gt;-ascorbate peroxidase (EC 1.11.1.11).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:73181</oboInOwl:id>
        <rdfs:label>EC 1.11.1.11 (L-ascorbate peroxidase) inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33286"/>
        <obo:IAO_0000115>Any compound that protects plants by activating their defence mechanisms.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:73182</oboInOwl:id>
        <rdfs:label>plant activator</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73216 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76759"/>
        <obo:IAO_0000115>Any hydrolase inhibitor that interferes with the action of a hydrolase which acts on acid anhydrides (EC 3.6.*.*).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:73216</oboInOwl:id>
        <rdfs:label>EC 3.6.* (hydrolases acting on acid anhydrides) inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73263 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35544"/>
        <obo:IAO_0000115>A cyclooxygenase inhibitor that interferes with the action of cyclooxygenase 3.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:73263</oboInOwl:id>
        <rdfs:label>cyclooxygenase 3 inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73336 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>A drug used in treating and healing of wounds.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:73336</oboInOwl:id>
        <rdfs:label>vulnerary</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73474 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_72695"/>
        <obo:IAO_0000115>Any organic molecule containing a C≡C bond.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:73474</oboInOwl:id>
        <rdfs:label>acetylenic compound</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73477 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73477">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_73474"/>
        <obo:IAO_0000115>An acetylenic compound which a carbon of the C≡C moiety is attached to a hydrogen atom.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:73477</oboInOwl:id>
        <rdfs:label>terminal acetylenic compound</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73558 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27300"/>
        <obo:IAO_0000115>A vitamin D that is calciol or its hydroxylated metabolites calcidiol and calcitriol. Calciol (also known as vitamin D&lt;small&gt;&lt;sub&gt;3&lt;/sub&gt;&lt;/small&gt;) acts as a hormone precursor, being hydroxylated in the liver to calcidiol (25-hydroxyvitamin D&lt;small&gt;&lt;sub&gt;3&lt;/sub&gt;&lt;/small&gt;), which is then further hydroxylated in the kidney to give calcitriol (1,25-dihydroxyvitamin D&lt;small&gt;&lt;sub&gt;3&lt;/sub&gt;&lt;/small&gt;), the active hormone.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:73558</oboInOwl:id>
        <rdfs:label>D3 vitamins</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73690 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73690">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_15705"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_83813"/>
        <obo:IAO_0000115>An &lt;small&gt;L&lt;/small&gt;-α-amino acid which is biosynthesised from erythrose 4-phosphate and phosphoenolpyruvate (i.e. phenylalanine, tyrosine, and tryptophan). A closed class.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:73690</oboInOwl:id>
        <rdfs:label>erythrose 4-phosphate/phosphoenolpyruvate family amino acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_74494 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_74494">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_68472"/>
        <obo:IAO_0000115>A pyrimidine deoxyribonucleoside that is a pyrimidine ribonucleoside in which the hydroxy group at the 5&apos; position is replaced by a hydrogen.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:74494</oboInOwl:id>
        <rdfs:label>pyrimidine 5&apos;-deoxyribonucleoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_74518 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_74518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_52210"/>
        <obo:IAO_0000115>Any substance which is used to reduce or control weight.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:74518</oboInOwl:id>
        <rdfs:label>anti-obesity agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_74634 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_74634">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26766"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50523"/>
        <obo:IAO_0000115>Any steroid lactone that is a  C23 steroid with a five-membered lactone ring at C-17 and its substituted derivatives. They form the aglycone constituents of cardiac glycosides.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:74634</oboInOwl:id>
        <rdfs:label>cardenolides</rdfs:label>
    </owl:Class>
    


