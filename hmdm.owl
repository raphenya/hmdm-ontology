    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35337 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35470"/>
        <obo:IAO_0000115>Any drug that enhances the activity of the central nervous system.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35337</oboInOwl:id>
        <rdfs:label>central nervous system stimulant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_3534 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_3534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23066"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_72588"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_88225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36047"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0018034"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59392"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A semisynthetic first-generation cephalosporin antibiotic having methyl and β-(2&lt;i&gt;R&lt;/i&gt;)-2-amino-2-phenylacetamido groups at the 3- and 7- of the cephem skeleton, respectively. It is effective against both Gram-negative and Gram-positive organisms, and is used for treatment of infections of the skin, respiratory tract and urinary tract.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:3534</oboInOwl:id>
        <rdfs:label>cephalexin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18059"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51958"/>
        <obo:IAO_0000115>Any of naturally occurring compounds and synthetic analogues, based on the cyclopenta[&lt;em&gt;a&lt;/em&gt;]phenanthrene carbon skeleton, partially or completely hydrogenated; there are usually methyl groups at C-10 and C-13, and often an alkyl group at C-17. By extension, one or more bond scissions, ring expansions and/or ring contractions of the skeleton may have occurred. Natural steroids are derived biogenetically from squalene which is a triterpene.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35341</oboInOwl:id>
        <rdfs:label>steroid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35342 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36838"/>
        <obo:IAO_0000115>The α-stereoisomer of 17-hydroxy steroid.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35342</oboInOwl:id>
        <rdfs:label>17alpha-hydroxy steroid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35343 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36838"/>
        <obo:IAO_0000115>A 17-hydroxy steroid in which the hydroxy group at position 17 has a β-configuration.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35343</oboInOwl:id>
        <rdfs:label>17beta-hydroxy steroid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35344 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35350"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35344</oboInOwl:id>
        <rdfs:label>21-hydroxy steroid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35346 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36841"/>
        <obo:IAO_0000115>Any 11-hydroxy steroid in which the hydroxy group at position 11 has β- configuration.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35346</oboInOwl:id>
        <rdfs:label>11beta-hydroxy steroid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35348 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_15889"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36836"/>
        <obo:IAO_0000115>A sterol in which the hydroxy group at position 3 has β- configuration.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35348</oboInOwl:id>
        <rdfs:label>3beta-sterol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35350 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35350">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33822"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35341"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35350</oboInOwl:id>
        <rdfs:label>hydroxy steroid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35352 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33285"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51143"/>
        <obo:IAO_0000115>Any heteroorganic entity containing at least one carbon-nitrogen bond.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35352</oboInOwl:id>
        <rdfs:label>organonitrogen compound</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35358 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33256"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33261"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33552"/>
        <obo:IAO_0000115>An amide of a sulfonic acid RS(=O)&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt;NR&apos;&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt;.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35358</oboInOwl:id>
        <rdfs:label>sulfonamide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35359 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35359">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_2634"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35352"/>
        <obo:IAO_0000115>Compounds having the structure RC(=NR)NR&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt;. The term is used as a suffix in systematic nomenclature to denote the ‒C(=NH)NH&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt; group including its carbon atom.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35359</oboInOwl:id>
        <rdfs:label>carboxamidine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35366 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35366">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18059"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25384"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0018034"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28868"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any aliphatic monocarboxylic acid derived from or contained in esterified form in an animal or vegetable fat, oil or wax. Natural fatty acids commonly have a chain of 4 to 28 carbons (usually unbranched and even-numbered), which may be saturated or unsaturated. By extension, the term is sometimes used to embrace all acyclic aliphatic carboxylic acids.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35366</oboInOwl:id>
        <rdfs:label>fatty acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35378 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35378">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36233"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35378</oboInOwl:id>
        <rdfs:label>glycosylfructose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35381 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35381">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16646"/>
        <obo:IAO_0000115>Parent monosaccharides are polyhydroxy aldehydes H[CH(OH)]&lt;small&gt;&lt;sub&gt;&lt;em&gt;n&lt;/em&gt;&lt;/sub&gt;&lt;/small&gt;C(=O)H or polyhydroxy ketones H‒[CHOH]&lt;small&gt;&lt;sub&gt;&lt;em&gt;n&lt;/em&gt;&lt;/sub&gt;&lt;/small&gt;‒C(=O)[CHOH]&lt;small&gt;&lt;sub&gt;&lt;em&gt;m&lt;/em&gt;&lt;/sub&gt;&lt;/small&gt;‒H with three or more carbon atoms. The generic term &apos;monosaccharide&apos; (as opposed to oligosaccharide or polysaccharide) denotes a single unit, without glycosidic connection to other such units. It includes aldoses, dialdoses, aldoketoses, ketoses and diketoses, as well as deoxy sugars, provided that the parent compound has a (potential) carbonyl group.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35381</oboInOwl:id>
        <rdfs:label>monosaccharide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35406 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25741"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33273"/>
        <obo:IAO_0000115>An oxoanion is an anion derived from an oxoacid by loss of hydron(s) bound to oxygen.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35406</oboInOwl:id>
        <rdfs:label>oxoanion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35426 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35296"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35428"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35426</oboInOwl:id>
        <rdfs:label>ortho-fused bicyclic arene</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35427 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33637"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35427</oboInOwl:id>
        <rdfs:label>ortho-fused polycyclic hydrocarbon</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33637"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36785"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35428</oboInOwl:id>
        <rdfs:label>ortho-fused bicyclic hydrocarbon</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35436 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24278"/>
        <obo:IAO_0000115>Any glucoside in which the glycoside group is derived from &lt;small&gt;D&lt;/small&gt;-glucose.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35436</oboInOwl:id>
        <rdfs:label>D-glucoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35441 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>A substance used in the prophylaxis or therapy of infectious diseases.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35441</oboInOwl:id>
        <rdfs:label>antiinfective agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35442 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35442">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35441"/>
        <obo:IAO_0000115>A substance used to treat or prevent parasitic infections.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35442</oboInOwl:id>
        <rdfs:label>antiparasitic agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35457 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35674"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76782"/>
        <obo:IAO_0000115>An EC 3.4.15.* (peptidyl-dipeptidase) inhibitor that interferes with the action of peptidyl-dipeptidase A (EC 3.4.15.1).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35457</oboInOwl:id>
        <rdfs:label>EC 3.4.15.1 (peptidyl-dipeptidase A) inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35469 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35471"/>
        <obo:IAO_0000115>Antidepressants are mood-stimulating drugs used primarily in the treatment of affective disorders and related conditions.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35469</oboInOwl:id>
        <rdfs:label>antidepressant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35470 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>A class of drugs producing both physiological and psychological effects through a variety of mechanisms involving the central nervous system.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35470</oboInOwl:id>
        <rdfs:label>central nervous system drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35471 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35470"/>
        <obo:IAO_0000115>A loosely defined grouping of drugs that have effects on psychological function.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35471</oboInOwl:id>
        <rdfs:label>psychotropic drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35472 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_67079"/>
        <obo:IAO_0000115>A substance that reduces or suppresses inflammation.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35472</oboInOwl:id>
        <rdfs:label>anti-inflammatory drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35473 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35471"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35488"/>
        <obo:IAO_0000115>A traditional grouping of drugs said to have a soothing or calming effect on mood, thought or behaviour.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35473</oboInOwl:id>
        <rdfs:label>tranquilizing drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35474 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35473"/>
        <obo:IAO_0000115>Anxiolytic drugs are agents that alleviate anxiety, tension, and anxiety disorders, promote sedation, and have a calming effect without affecting clarity of consciousness or neurologic conditions.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35474</oboInOwl:id>
        <rdfs:label>anxiolytic drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35475 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35475">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35472"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35842"/>
        <obo:IAO_0000115>An anti-inflammatory drug that is not a steroid. In addition to anti-inflammatory actions, non-steroidal anti-inflammatory drugs have analgesic, antipyretic, and platelet-inhibitory actions. They act by blocking the synthesis of prostaglandins by inhibiting cyclooxygenase, which converts arachidonic acid to cyclic endoperoxides, precursors of prostaglandins.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35475</oboInOwl:id>
        <rdfs:label>non-steroidal anti-inflammatory drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35476 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35476">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35473"/>
        <obo:IAO_0000115>Antipsychotic drugs are agents that control agitated psychotic behaviour, alleviate acute psychotic states, reduce psychotic symptoms, and exert a quieting effect.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35476</oboInOwl:id>
        <rdfs:label>antipsychotic agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35477 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35477">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35473"/>
        <obo:IAO_0000115>Antimanic drugs are agents used to treat bipolar disorders or mania associated with other affective disorders.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35477</oboInOwl:id>
        <rdfs:label>antimanic drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35479 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35479">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24866"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33296"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35479</oboInOwl:id>
        <rdfs:label>alkali metal salt</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35480 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35480">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_52210"/>
        <obo:IAO_0000115>An agent capable of relieving pain without the loss of consciousness or without producing anaesthesia. In addition, analgesic is a role played by a compound which is exhibited by a capability to cause a reduction of pain symptoms.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35480</oboInOwl:id>
        <rdfs:label>analgesic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35481 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35480"/>
        <obo:IAO_0000115>A drug that has principally analgesic, antipyretic and anti-inflammatory actions. Non-narcotic analgesics do not bind to opioid receptors.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35481</oboInOwl:id>
        <rdfs:label>non-narcotic analgesic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35482 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35480"/>
        <obo:IAO_0000115>A narcotic or opioid substance, synthetic or semisynthetic agent producing profound analgesia, drowsiness, and changes in mood.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35482</oboInOwl:id>
        <rdfs:label>opioid analgesic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35488 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35470"/>
        <obo:IAO_0000115>A loosely defined group of drugs that tend to reduce the activity of the central nervous system.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35488</oboInOwl:id>
        <rdfs:label>central nervous system depressant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35493 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>A drug that prevents or reduces fever by lowering the body temperature from a raised state. An antipyretic will not affect the normal body temperature if one does not have fever. Antipyretics cause the hypothalamus to override an interleukin-induced increase in temperature. The body will then work to lower the temperature and the result is a reduction in fever.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35493</oboInOwl:id>
        <rdfs:label>antipyretic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35496 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35496">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22712"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37143"/>
        <obo:IAO_0000115>Any fluoroarene that is a benzene or a substituted benzene carrying at least one fluoro group.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35496</oboInOwl:id>
        <rdfs:label>fluorobenzenes</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35498 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>An agent that promotes the excretion of urine through its effects on kidney function.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35498</oboInOwl:id>
        <rdfs:label>diuretic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35499 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35471"/>
        <obo:IAO_0000115>Drugs capable of inducing illusions, hallucinations, delusions, paranoid ideations and other alterations of mood and thinking.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35499</oboInOwl:id>
        <rdfs:label>hallucinogen</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35500 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22720"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35500</oboInOwl:id>
        <rdfs:label>1,4-benzodiazepinone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35506 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35507"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35506</oboInOwl:id>
        <rdfs:label>alkaloid fundamental parent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35507 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35507">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33245"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35507</oboInOwl:id>
        <rdfs:label>natural product fundamental parent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35508 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35341"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35507"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35508</oboInOwl:id>
        <rdfs:label>steroid fundamental parent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35509 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35509">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35508"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35509</oboInOwl:id>
        <rdfs:label>androstane</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35522 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37886"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48540"/>
        <obo:IAO_0000115>An agent that selectively binds to and activates β-adrenergic receptors.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35522</oboInOwl:id>
        <rdfs:label>beta-adrenergic agonist</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35523 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>An agent that causes an increase in the expansion of a bronchus or bronchial tubes.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35523</oboInOwl:id>
        <rdfs:label>bronchodilator agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35524 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35524">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37962"/>
        <obo:IAO_0000115>A drug that mimics the effects of stimulating postganglionic adrenergic sympathetic nerves. Included in this class are drugs that directly stimulate adrenergic receptors and drugs that act indirectly by provoking the release of adrenergic transmitters.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35524</oboInOwl:id>
        <rdfs:label>sympathomimetic agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35526 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>A drug which lowers the blood glucose level.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35526</oboInOwl:id>
        <rdfs:label>hypoglycemic agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35530 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35530">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37887"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48540"/>
        <obo:IAO_0000115>An agent that binds to but does not activate β-adrenergic receptors thereby blocking the actions of endogenous or exogenous β-adrenergic agonists. β-Adrenergic antagonists are used for treatment of hypertension, cardiac arrhythmias, angina pectoris, glaucoma, migraine headaches and anxiety.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35530</oboInOwl:id>
        <rdfs:label>beta-adrenergic antagonist</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35533 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35533">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22478"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35533</oboInOwl:id>
        <rdfs:label>propanolamine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35542 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35543"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35542</oboInOwl:id>
        <rdfs:label>5beta-cardanolide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26766"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35508"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
