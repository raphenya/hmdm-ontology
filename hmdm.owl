                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33704"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An amino acid-zwitterion obtained by transfer of a proton from the carboxy to the amino group of any α-amino acid; major species at pH 7.3.</obo:IAO_0000115>
