    <!-- http://purl.obolibrary.org/obo/HMDM_0000825 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HMDM_0000825">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
