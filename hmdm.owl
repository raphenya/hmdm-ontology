        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50689"/>
        <obo:IAO_0000115>A chemical substance that prevents or reduces the probability of conception.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:49323</oboInOwl:id>
        <rdfs:label>contraceptive drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_49324 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_49324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_49323"/>
        <obo:IAO_0000115>A chemical substance or agent with contraceptive activity in females.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:49324</oboInOwl:id>
        <rdfs:label>female contraceptive drug</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_49325 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_49325">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_49324"/>
        <obo:IAO_0000115>A compound, usually hormonal, taken orally in order to block ovulation and prevent the occurrence of pregnancy.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:49325</oboInOwl:id>
        <rdfs:label>oral contraceptive</rdfs:label>
    </owl:Class>
    


