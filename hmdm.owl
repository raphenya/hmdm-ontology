        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>Any amino-acid that is not naturally encoded in the genetic code of any organism.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:83820</oboInOwl:id>
