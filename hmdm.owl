        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17891"/>
        <obo:IAO_0000115>An agent, with unique chemical structure and biochemical requirements, which generates nitric oxide.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50566</oboInOwl:id>
        <rdfs:label>nitric oxide donor</rdfs:label>
    </owl:Class>
    


