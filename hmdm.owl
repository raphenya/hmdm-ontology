            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An organic bromide salt having (1α,2β,4β,5α,7β)-7-[(hydroxydi-2-thienylacetyl)oxy]-9,9-dimethyl-3-oxa-9-azoniatricyclo[3.3.1.0&lt;small&gt;&lt;sup&gt;2,4&lt;/small&gt;&lt;/sup&gt;]nonane as the counterion. Used (in the form of the hydrate) for maintenance treatment of airflow obstruction in patients with chronic obstructive pulmonary disease.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:90959</oboInOwl:id>
        <rdfs:label>tiotropium bromide</rdfs:label>
    </owl:Class>
    


