            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any branched-chain fatty acid containing methyl branches only.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:62499</oboInOwl:id>
        <rdfs:label>methyl-branched fatty acid</rdfs:label>
    </owl:Class>
    


