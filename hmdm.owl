        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:27171</oboInOwl:id>
        <rdfs:label>organic heterobicyclic compound</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_62761"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_84144"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0018038"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17895"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A proteinogenic amino acid derivative resulting from reaction of &lt;small&gt;L&lt;/small&gt;-tyrosine at the amino group or the carboxy group, or from the replacement of any hydrogen of &lt;small&gt;L&lt;/small&gt;-tyrosine by a heteroatom.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:27177</oboInOwl:id>
        <rdfs:label>L-tyrosine derivative</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27207 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37838"/>
        <obo:IAO_0000115>A univalent carboacyl group is a group formed by loss of OH from the carboxy group of a carboxylic acid.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:27207</oboInOwl:id>
        <rdfs:label>univalent carboacyl group</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35366"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0018034"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_2580"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any fatty acid containing at least one C=C or C≡C bond.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:27208</oboInOwl:id>
        <rdfs:label>unsaturated fatty acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36853"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any member of a group of fat-soluble hydroxy seco-steroids that exhibit biological activity against vitamin D deficiency. Vitamin D  can be obtained from sun exposure, food and supplements and is biologically inactive and converted into the biologically active calcitriol via double hydroxylation in the body.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:27300</oboInOwl:id>
        <rdfs:label>vitamin D</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27311 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76924"/>
        <obo:IAO_0000115>Any plant metabolite that is found naturally as a component of a volatile oil.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:27311</oboInOwl:id>
        <rdfs:label>volatile oil component</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27314 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33229"/>
        <obo:IAO_0000115>Any vitamin that dissolves in water and readily absorbed into tissues for immediate use. Unlike the fat-soluble vitamins, they are not stored in the body and need to be replenished regularly in the diet and will rarely accumulate to toxic levels since they are quickly excreted from the body via urine.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:27314</oboInOwl:id>
        <rdfs:label>water-soluble vitamin (role)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_27369 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27369">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51151"/>
        <obo:IAO_0000115>A neutral compound having formal unit electrical charges of opposite sign on non-adjacent atoms. Sometimes referred to as inner salts, dipolar ions (a misnomer).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:27369</oboInOwl:id>
        <rdfs:label>zwitterion</rdfs:label>
    </owl:Class>
    


